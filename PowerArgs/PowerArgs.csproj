<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>5.0.0</Version>
    <Authors>Adam Abdelhamed</Authors>
    <Company>Adam Abdelhamed</Company>
    <Product>PowerArgs</Product>
    <Description>The ultimate command line application framework</Description>
    <Copyright>Copyright 2022 (c) Adam Abdelhamed. All rights reserved.</Copyright>
    <PackageProjectUrl>https://github.com/adamabdelhamed/powerargs</PackageProjectUrl>
    <PackageTags>command line; arguments parser; CLI; .NET</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/adamabdelhamed/powerargs</RepositoryUrl>
    <WarningLevel>1</WarningLevel>
    <PackageReleaseNotes>Add JsonConsoleString, strong naming</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SignAssembly>True</SignAssembly>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\PowerArgs.Generator\bin\$(Configuration)\netstandard2.0\PowerArgs.Generator.dll">
      <Pack>True</Pack>
      <PackagePath>analyzers/dotnet/cs</PackagePath>
      <Visible>False</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerArgs.Generator\PowerArgs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
